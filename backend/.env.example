# Copy this file to .env in the backend/ directory and adjust as needed.

# Change this in production - used to sign admin JWT session tokens
SECRET_KEY=change_me_to_a_long_random_value

# How long an admin login session lasts, in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ---- OpenTelemetry (optional) ----
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_CONSOLE_EXPORTER=false

# ---- SSO / OIDC (optional) ----
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=http://localhost:8000/api/auth/sso/callback
SSO_DEFAULT_ROLE=viewer
FRONTEND_BASE_URL=http://localhost:8000

# ---- Logging (rolling log files) ----
# "time" = daily/interval rotation (default), "size" = rotate at a byte threshold
LOG_ROTATION_TYPE=time
LOG_ROTATION_WHEN=midnight
LOG_ROTATION_INTERVAL=1
LOG_ROTATION_BACKUP_COUNT=14
LOG_ROTATION_MAX_BYTES=5000000

# ---- CometD reconnect backoff ----
COMETD_RECONNECT_MIN_DELAY_SECONDS=2.0
COMETD_RECONNECT_MAX_DELAY_SECONDS=60.0
COMETD_RECONNECT_BACKOFF_FACTOR=2.0

# ---- Uvicorn server (see README: "Server configuration") ----
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000
UVICORN_RELOAD=false
UVICORN_LOG_LEVEL=info
# Leave at 1 - see README "Server configuration" for why more than one breaks the app
UVICORN_WORKERS=1

# ---- Custom payload processor subprocess timeout (seconds) ----
PROCESSOR_TIMEOUT_SECONDS=20
