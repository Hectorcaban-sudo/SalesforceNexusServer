# Copy this file to .env in the project root before running `docker compose up`.
# (For running the backend directly without Docker, use backend/.env.example instead.)

# Change this in production - used to sign admin JWT session tokens
SECRET_KEY=change_me_to_a_long_random_value

# How long an admin login session lasts, in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ---- OpenTelemetry (optional) ----
# Point this at your collector (Jaeger, Tempo, Honeycomb, Datadog agent, etc.)
# to export traces. Leave blank to run with tracing enabled but nothing exported.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Set to true to print spans to stdout instead of/alongside OTLP export - handy for local debugging.
OTEL_CONSOLE_EXPORTER=false

# ---- SSO / OIDC (optional) ----
# Works with any OIDC-compliant identity provider: Okta, Azure AD / Entra ID,
# Auth0, Google Workspace, Keycloak, etc. Leave SSO_ISSUER blank to disable SSO
# entirely and use local username/password accounts only.
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=http://localhost:8000/api/auth/sso/callback
SSO_DEFAULT_ROLE=viewer
FRONTEND_BASE_URL=http://localhost:8000
