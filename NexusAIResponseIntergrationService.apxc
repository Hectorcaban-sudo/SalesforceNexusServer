public with sharing class NexusAIResponseIntergrationService {
    public class NexusAIRequest{
                @InvocableVariable(label='Agent session Id')
        public string sessionID;
    }
    
    public class NexusAIReqesponse{
        
        @InvocableVariable(label='RequestID')
        public string requestID;
        
        @InvocableVariable(label='Message')
        public string mesage;
    }
	@InvocableMethod(label='Get Nexus AI Chat Response')
    public static list<NexusAIReqesponse> performExternalOperation(List<NexusAIRequest> requests){
		
            list<NexusAIReqesponse> out = new list<NexusAIReqesponse>();
            System.debug(requests);
        	
            for(NexusAIRequest r: requests) 
            {
                // Generate correlation ID for tracking
                String conversationId = r.sessionID;
                //Map<String, string> dataMap = (Map<String, string>) JSON.deserializeUntyped(r.payloadJason);
				
				String url = 'https://default03b86c3a89544d199522e464fe9f22c.e.environment.api.high.powerplatform.microsoft.us:443/powerautomate/automations/direct/workflows/de3b2f15dd944de790761877cf753fcc/triggers/manual/paths/invoke?api-version=1&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=nReAYlGxm1y77KoxDWK7tbxDpHZnbHZuyVv4kd1vlSw';
               
                Http http = new Http();
                HttpRequest request = new HttpRequest();
                request.setTimeout(60000); 
                 // 1. Create a wrapper instance or JSON string
                Map<String, Object> payload = new Map<String, Object>{
                    'ConversationId' => conversationId
                };
                String jsonBody = JSON.serialize(payload);
                
                // Set the endpoint URL
                request.setEndpoint(url);
                request.setMethod('POST');
                request.setHeader('Content-Type', 'application/json;charset=UTF-8');
        		request.setBody(jsonBody);
                
                // Send the request
                HttpResponse response = http.send(request);
                
                // Verify successful response
                //if (response.getStatusCode() == 200) {
                  //  System.debug(response.getBody());
                //}
                System.debug(response.getStatusCode());
                System.debug(response.getBody());
                
                    
                NexusAIReqesponse nexusResponse = new NexusAIReqesponse();
                nexusResponse.requestID = conversationId;
                nexusResponse.mesage = response.getBody();
                out.add(nexusResponse);    
        	}

        return out;		
    }
}
