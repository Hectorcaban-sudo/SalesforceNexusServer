public with sharing class NexusAIIntergrationService {
	
    public class NexusAIRequest{
        
        @InvocableVariable(required=true label='User last message')
        public string message;
        
        @InvocableVariable(label='Agent session Id')
        public string sessionID;
    }
    
    public class NexusAIReqesponse{
        
        @InvocableVariable(label='RequestID')
        public string requestID;
        
        @InvocableVariable(label='Message')
        public string mesage;
    }
    
    @InvocableMethod(label='Submit Nexus AI Chat Request')
    public static list<NexusAIReqesponse> getExternalOperation(List<NexusAIRequest> requests){
		
            list<NexusAIReqesponse> out = new list<NexusAIReqesponse>();
            System.debug(requests);
        	
            for(NexusAIRequest r: requests) 
            {
                // Generate correlation ID for tracking
                String correlationId = String.valueOf(Crypto.getRandomLong());
                //Map<String, string> dataMap = (Map<String, string>) JSON.deserializeUntyped(r.payloadJason);
				//String jsonString = r;
                //System.debug(jsonString);
                //Map<String, Object> dataMap = (Map<String, Object>) JSON.deserializeUntyped(jsonString);
                
                //String message = (String) dataMap.get('message');
                System.debug('Message: ' + r.message);
				String message = r.message;
                NexusAI_Chat_Request__e req = new NexusAI_Chat_Request__e();
                req.Conversation_Id__c = correlationId;
                req.User_Message__c = message;// 'Hi How are you ?'; //(String) dataMap.get('message');
                req.User_Id__c = '005t0000002hybhAAA';
                req.Mode__c = 'chat';
                req.History_Json__c = '';
                EventBus.publish(req);
                    
                NexusAIReqesponse response = new NexusAIReqesponse();
                response.requestID = correlationId;
                response.mesage = 'Request as been submitted: ' + req.User_Message__c;
                out.add(response);    
        	}

        return out;		
    } 
    
     
}
